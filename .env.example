# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token

# Sanity webhook revalidation (set in Sanity Manage → API → Webhooks)
SANITY_REVALIDATE_SECRET=your-revalidate-secret

# Resend (transactional email)
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL=hello@jungla.com

# Site
NEXT_PUBLIC_SITE_URL=https://jungla.com

# Analytics (optional — omit to disable)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=jungla.com
